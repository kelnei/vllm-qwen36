# Copy this to .env and fill in your HF token, or export it in your shell:
#
#   export HF_TOKEN=hf_xxxx
#   docker compose up -d
#
HF_TOKEN=

# Two-Spark Ray cluster (run_cluster.sh): the worker and `serve` find the head
# node here — its IP on the 200G link, not the management LAN.
#CLUSTER_HEAD_IP=192.168.200.16

# On a DGX Spark (GB10), single-node serving should use the tuned compose file:
#COMPOSE_FILE=docker-compose.spark.yml

# On a dedicated RTX 5090 (32 GB), serve Qwen3.8-27B with its own profile:
#COMPOSE_FILE=docker-compose.rtx5090.yml
